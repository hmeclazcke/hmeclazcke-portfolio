{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmeclazcke.github.io/hmeclazcke-portfolio/schema/relationships.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "technologyId", "contextId", "meanings"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "technologyId": { "type": "string", "minLength": 1 },
      "contextId": { "type": "string", "minLength": 1 },
      "meanings": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["learned", "used"] }
      }
    }
  }
}
